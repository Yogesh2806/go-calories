# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (Project Settings -> API) ------------------------------
# Both values are safe to expose in the browser (access is enforced by Row Level Security).
# Leave blank to run in "this device only" mode (no sign-in, data in localStorage).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# There is deliberately NO Gemini key here: each user pastes their own key in
# Settings -> AI Food Parsing, and it stays in their browser.
